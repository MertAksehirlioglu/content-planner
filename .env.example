# Public build-time identifiers for the web app. Not secrets — they ship in the bundle.
# Generate the real thing after `terraform apply`:
#
#   terraform -chdir=infra output -raw env_local > .env.local
#
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=my-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=my-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=my-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Must match infra's `region` var and the region in functions/src/*.ts.
NEXT_PUBLIC_FUNCTIONS_REGION=europe-west1
