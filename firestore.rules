rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      match /accounts/{account} {
        // Owner-writable account data.
        allow read, write: if isOwner(uid);
        match /items/{document=**} { allow read, write: if isOwner(uid); }
        // weeks + everything under it (media assets and their base64 chunks) is owner-writable.
        match /weeks/{document=**} { allow read, write: if isOwner(uid); }
        // Usage events are written only by the proxy (Admin SDK); the client may read.
        // Kept as its own non-recursive match so no owner-write rule above overlaps it —
        // Firestore grants on ANY match, so a recursive allow would defeat this deny.
        match /usage/{event} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
      // Budget + spend counters: read-only to the owner, written only by the Admin SDK.
      match /billing/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
